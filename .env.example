# Copy this file to .env for local development.
# On Vercel / Netlify / etc. add the same names in the project's Environment Variables settings.

# Supabase -> Project Settings -> API (use the "publishable" / anon key, never the service_role key)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API key (free): https://aistudio.google.com/apikey
# Server-side only. Never prefix it with VITE_.
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest. Any Gemini model that accepts images works.
# GEMINI_MODEL=gemini-flash-latest
